# ===== LLM =====
# gemini 或 claude
LLM_PROVIDER=gemini
# 填写官方文档中当前可用的模型名
LLM_MODEL=
# 仅 Gemini：主模型过载/超时时自动改用这个模型（可留空）
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
# 只放在这里，不要全局 export
ANTHROPIC_API_KEY=
# 仅 Claude：low / medium / high，留空用模型默认值
LLM_EFFORT=
ENABLE_WEB_SEARCH=false

# ===== ESPN Fantasy =====
ESPN_LEAGUE_ID=
# 2026-27 赛季，首次运行时验证
ESPN_SEASON_YEAR=2027
# 私有联赛必填，公开联赛可留空
ESPN_S2=
# 带花括号，原样粘贴
ESPN_SWID=
ESPN_MY_TEAM_NAME=

# ===== 其他 =====
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO
